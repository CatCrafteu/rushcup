# Database
DATABASE_URL="file:./dev.db"

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_SECRET="generate-with-openssl-rand-base64-32"

# Auth
JWT_SECRET="generate-with-openssl-rand-base64-32"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_EXPIRES_IN="30d"
BCRYPT_ROUNDS=12

# Encryption (for Steam credentials)
ENCRYPTION_KEY="generate-32-byte-hex-key"
ENCRYPTION_IV="generate-16-byte-hex-iv"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
API_RATE_LIMIT_MAX=60

# Security
CSP_ENABLED=true
CSRF_ENABLED=true
SECURE_COOKIES=true
SAME_SITE_COOKIE="lax"

# CORS
ALLOWED_ORIGINS="http://localhost:3000"

# Crypto Payments - Coinbase Commerce
COINBASE_COMMERCE_API_KEY=""
COINBASE_COMMERCE_WEBHOOK_SECRET=""
COINBASE_COMMERCE_WEBHOOK_URL=""

# Crypto Payments - NowPayments
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
NOWPAYMENTS_IPN_URL=""

# Steam API (optional, for rank verification)
STEAM_API_KEY=""

# Admin
ADMIN_EMAILS="admin@example.com"

# Email (optional, for notifications)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

# Monitoring
SENTRY_DSN=""
LOG_LEVEL="info"