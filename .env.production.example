# Database
DATABASE_URL="file:./prod.db"

# App
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://your-domain.com"
APP_SECRET="your-32-char-base64-secret-here"

# Auth
JWT_SECRET="your-32-char-base64-secret-here"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_EXPIRES_IN="30d"
BCRYPT_ROUNDS=12

# Encryption (for Steam credentials)
ENCRYPTION_KEY="your-32-byte-hex-key-here"
ENCRYPTION_IV="your-16-byte-hex-iv-here"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
API_RATE_LIMIT_MAX=60

# Security
CSP_ENABLED=true
CSRF_ENABLED=true
SECURE_COOKIES=true
SAME_SITE_COOKIE="lax"

# CORS - REPLACE WITH YOUR DOMAIN
ALLOWED_ORIGINS="https://your-domain.com"

# Crypto Payments - Coinbase Commerce
COINBASE_COMMERCE_API_KEY="your-api-key"
COINBASE_COMMERCE_WEBHOOK_SECRET="your-webhook-secret"
COINBASE_COMMERCE_WEBHOOK_URL="https://your-domain.com/api/payments/webhook/coinbase"

# Crypto Payments - NowPayments
NOWPAYMENTS_API_KEY="your-api-key"
NOWPAYMENTS_IPN_SECRET="your-ipn-secret"
NOWPAYMENTS_IPN_URL="https://your-domain.com/api/payments/webhook/nowpayments"

# Steam API (optional, for rank verification)
STEAM_API_KEY="your-steam-api-key"

# Admin
ADMIN_EMAILS="admin@your-domain.com"

# Email (optional, for notifications)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

# Monitoring
SENTRY_DSN=""
LOG_LEVEL="info"